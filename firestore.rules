rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isModerator() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ismoderator == true;
    }

    function activityLogIsSafe() {
      return !('metadata' in request.resource.data) ||
        (
          !('password' in request.resource.data.metadata) &&
          !('token' in request.resource.data.metadata) &&
          !('email' in request.resource.data.metadata) &&
          !('authorization' in request.resource.data.metadata)
        );
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) || isModerator();
      allow update: if isOwner(uid) || isModerator();
      allow delete: if isModerator();

      match /notifications/{notificationId} {
        allow read, update: if isOwner(uid);
        allow create: if isOwner(uid) || isModerator();
        allow delete: if isModerator();
      }

      match /fcmTokens/{tokenId} {
        allow read: if isOwner(uid) || isModerator();
        allow create, update, delete: if isOwner(uid);
      }

      match /{document=**} {
        allow read, write: if isOwner(uid) || isModerator();
      }
    }

    match /activityLogs/{logId} {
      allow read: if isModerator();
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        activityLogIsSafe();
      allow update, delete: if false;
    }

    match /voorspellingen/{predictionId} {
      allow read: if signedIn();
      allow create, update: if signedIn() &&
        request.resource.data.gebruikerId == request.auth.uid;
      allow delete: if isModerator();
    }

    match /seasons/{seasonId}/{document=**} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /system/{document=**} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /{document=**} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
