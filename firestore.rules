rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function noDerivedPredictionFields() {
      return !request.resource.data.keys().hasAny(['punten','verwerkt','processed','verwerktVoorUitslag']);
    }
    function keepsDerivedPredictionFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['punten','verwerkt','processed','verwerktVoorUitslag']);
    }
    function safeUserScores() {
      return request.resource.data.get('punten_A',0) == 0 && request.resource.data.get('punten_B',0) == 0 && request.resource.data.get('totalen',0) == 0 && !request.resource.data.keys().hasAny(['rankingName','punten','eindstandA_awarded','eindstandB_awarded']);
    }
    function keepsUserScores() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['punten','punten_A','punten_B','totalen','rankingName','eindstandA_awarded','eindstandB_awarded']);
    }
    function processingMaintenance() {
      return exists(/databases/$(database)/documents/system/result_processing_maintenance) &&
        get(/databases/$(database)/documents/system/result_processing_maintenance).data.enabled == true;
    }
    function noBonusFields() {
      return !request.resource.data.keys().hasAny(['eindstand_A_punten','eindstand_B_punten']);
    }
    function keepsBonusFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['eindstand_A_punten','eindstand_B_punten']);
    }
    function safeMatchCreate() {
      return !request.resource.data.keys().hasAny(['processedInputKey','processingInputKey','processedAt','processingAttempts','processingFailedAt','processedResultKey','predictionSelectedUsers','predictionProcessedUsers','pouleProcessedUsers']) &&
        request.resource.data.get('processed',false) == false && request.resource.data.get('verwerkt',false) == false && request.resource.data.get('predictionProcessingComplete',false) == false && request.resource.data.get('processingStatus','pending') == 'pending';
    }
    function safeMatchUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['processedInputKey','processingInputKey','processedAt','processingAttempts','processingFailedAt','processedResultKey','predictionSelectedUsers','predictionProcessedUsers','pouleProcessedUsers']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['processed','verwerkt','predictionProcessingComplete','processingStatus']) ||
         (request.resource.data.get('processed',false) == false && request.resource.data.get('verwerkt',false) == false && request.resource.data.get('predictionProcessingComplete',false) == false && request.resource.data.get('processingStatus','pending') == 'pending'));
    }
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isModerator() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ismoderator == true;
    }

    function isPouleOwner(pouleId) {
      return signedIn() &&
        get(/databases/$(database)/documents/poules/$(pouleId)).data.ownerId == request.auth.uid;
    }

    function isNewPredictionOwner() {
      return signedIn() &&
        (
          request.resource.data.gebruikerId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid
        );
    }

    function isExistingPredictionOwner() {
      return signedIn() &&
        (
          resource.data.gebruikerId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid
        );
    }

    // Legacy eindstanddocumenten gebruiken de vaste id <uid>_<divisie>, maar
    // kunnen een eigenaarveld missen. Alleen de eigenaar van die vaste A/B-id
    // mag het document bij de eerstvolgende save naar het huidige schema brengen.
    function isOwnerlessOwnEindstandDocument(predictionId) {
      return signedIn() &&
        (
          predictionId == request.auth.uid + '_A' ||
          predictionId == request.auth.uid + '_B'
        ) &&
        !('gebruikerId' in resource.data) &&
        !('userId' in resource.data) &&
        !('uid' in resource.data);
    }

    function activityLogIsSafe() {
      return !('metadata' in request.resource.data) ||
        (
          !('password' in request.resource.data.metadata) &&
          !('token' in request.resource.data.metadata) &&
          !('email' in request.resource.data.metadata) &&
          !('authorization' in request.resource.data.metadata)
        );
    }

    function hasNoModeratorClaims() {
      return !request.resource.data.keys().hasAny(['ismoderator', 'isModerator']);
    }

    function keepsModeratorClaimsUnchanged() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(['ismoderator', 'isModerator']);
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if safeUserScores() && (isModerator() || (isOwner(uid) && hasNoModeratorClaims()));
      allow update: if keepsUserScores() && (isModerator() || (isOwner(uid) && keepsModeratorClaimsUnchanged()));
      allow delete: if !processingMaintenance() && isModerator();

      match /notifications/{notificationId} {
        allow read, update: if isOwner(uid);
        allow create: if isOwner(uid) || isModerator();
        allow delete: if isModerator() || (isOwner(uid) &&
          (resource.data.type in [
            'missing_predictions',
            'missing_prediction',
            'missing-predictions',
            'missingPrediction',
            'prediction_reminder',
            'prediction_reminders',
            'prediction-reminder',
            'predictionReminder',
            'missingPredictions'
          ] || notificationId.matches('missing[_-]predictions_.*') ||
          (resource.data.title == 'Voorspellingen ontbreken' &&
            resource.data.body is string &&
            resource.data.body.matches('.*wedstrijd.*niet voorspeld.*speelronde.*'))));
      }

      match /fcmTokens/{tokenId} {
        allow read: if isOwner(uid) || isModerator();
        allow create, update, delete: if isOwner(uid);
      }

      match /{collection}/{document=**} {
        allow read, write: if isOwner(uid) || isModerator();
      }
    }

    match /activityLogs/{logId} {
      allow read: if isModerator();
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        activityLogIsSafe();
      allow update, delete: if false;
    }

    match /voorspellingen/{predictionId} {
      allow read: if signedIn();
      allow create: if !processingMaintenance() && noDerivedPredictionFields() && (isModerator() || isNewPredictionOwner());
      allow update: if !processingMaintenance() && keepsDerivedPredictionFields() && (isModerator() || (isExistingPredictionOwner() && isNewPredictionOwner()));
      allow delete: if !processingMaintenance() && isModerator();
    }

    match /poules/{pouleId} {
      allow read: if true;
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isModerator() || isPouleOwner(pouleId);

      match /deelnemers/{uid} {
        allow read: if signedIn();
        allow create: if request.resource.data.get('punten',0) == 0 && (isModerator() || isPouleOwner(pouleId) || isOwner(uid));
        allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['punten']) && (isModerator() || isPouleOwner(pouleId) || isOwner(uid));
        allow delete: if !processingMaintenance() && (isModerator() || isPouleOwner(pouleId) || isOwner(uid));
      }
      match /{collection}/{document=**} {
        allow read: if signedIn();
        allow write: if collection != 'deelnemers' && (isModerator() || isPouleOwner(pouleId));
      }
    }

    match /poule_predictions/{predictionId} {
      allow read: if signedIn();
      allow create: if !processingMaintenance() && noDerivedPredictionFields() && (isModerator() || isNewPredictionOwner());
      allow update: if !processingMaintenance() && keepsDerivedPredictionFields() && (isModerator() || (isExistingPredictionOwner() && isNewPredictionOwner()));
      allow delete: if !processingMaintenance() && isModerator();
    }

    match /poule_voorspellingen/{predictionId} {
      allow read: if signedIn();
      allow create: if !processingMaintenance() && noDerivedPredictionFields() && (isModerator() || isNewPredictionOwner());
      allow update: if !processingMaintenance() && keepsDerivedPredictionFields() && (isModerator() || (isExistingPredictionOwner() && isNewPredictionOwner()));
      allow delete: if !processingMaintenance() && isModerator();
    }

    match /predictions/{predictionId} {
      allow read: if signedIn();
      allow create: if !processingMaintenance() && noDerivedPredictionFields() && (isModerator() || isNewPredictionOwner());
      allow update: if !processingMaintenance() && keepsDerivedPredictionFields() && (isModerator() || (isExistingPredictionOwner() && isNewPredictionOwner()));
      allow delete: if !processingMaintenance() && isModerator();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /standen/{standingId} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /periodestanden/{document=**} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /round_overrides/{overrideId} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /app_updates/{updateId} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /x_posts/{postId} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /standings_archive/{document=**} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /season_archives/{document=**} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /maintenance/{document=**} {
      allow read, write: if isModerator();
    }

    match /sync_logs/{logId} {
      allow read, write: if isModerator();
    }

    match /eindstand_voorspellingen/{predictionId} {
      allow read: if signedIn();
      allow create: if !processingMaintenance() && noBonusFields() && (isModerator() || isNewPredictionOwner());
      allow update: if !processingMaintenance() && keepsBonusFields() && (isModerator() ||
        ((isExistingPredictionOwner() || isOwnerlessOwnEindstandDocument(predictionId)) && isNewPredictionOwner()));
      allow delete: if !processingMaintenance() && isModerator();
    }

    match /voorspel_punten/{uid} {
      allow read: if isOwner(uid) || isModerator();
      allow write: if false;
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if isModerator();
      match /{collection}/{document=**} {
        allow read: if true;
        allow create: if !processingMaintenance() && isModerator() && !(collection in ['standings','periodStandings','processingAggregates','predictionContributions','pouleContributions','endstandContributions']) && (collection != 'predictions' || noDerivedPredictionFields()) && (collection != 'matches' || safeMatchCreate());
        allow update: if !processingMaintenance() && isModerator() && !(collection in ['standings','periodStandings','processingAggregates','predictionContributions','pouleContributions','endstandContributions']) && (collection != 'predictions' || keepsDerivedPredictionFields()) && (collection != 'matches' || safeMatchUpdate());
        allow delete: if !processingMaintenance() && isModerator() && !(collection in ['standings','periodStandings','processingAggregates','predictionContributions','pouleContributions','endstandContributions','matches']);
      }
    }

    match /system/{systemId}/{document=**} {
      allow read: if true;
      allow write: if systemId != 'result_processing_maintenance' && isModerator();
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
